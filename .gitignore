*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# reports/ is otherwise TRACKED on purpose: those files are the results, and
# several of them are what the report's tables are quoted from. The per-arm
# prediction files (reports/tuned_preds_*.csv) are a few MB each and well
# inside GitHub's limits; if that ever changes, exclude them here rather than
# dropping the whole directory.
